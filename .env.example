# ===== FACEBOOK LIVE (ưu tiên hoàn thiện trong bản 2.3) =====
# Bắt buộc là URL HTTPS public trỏ về Gateway qua reverse proxy/domain.
# Ví dụ: https://live-api.tenmiencuaban.vn
PUBLIC_BASE_URL=https://your-public-gateway.example.com

# Dùng để mã hóa token OAuth lưu trong gateway/data/. Nên là chuỗi dài ngẫu nhiên.
OAUTH_STORE_KEY=doi-thanh-khoa-ma-hoa-rat-dai
# OAUTH_STORE_FILE=./data/oauth-connections.enc.json

# Meta / Facebook Developer App
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
